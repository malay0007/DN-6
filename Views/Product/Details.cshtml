@model DN_6.Models.Product

<style>
    body {
        font-family: Arial, sans-serif;
        background-color: #f2f2f2;
    }

    h2 {
        text-align: center;
        color: darkblue;
        margin-top: 30px;
    }

    table {
        width: 50%;
        margin: 25px auto;
        border-collapse: collapse;
        background-color: white;
    }

    th, td {
        padding: 12px;
        border: 1px solid #ddd;
        text-align: left;
    }

    th {
        background-color: darkblue;
        color: white;
    }

    .back {
        display: block;
        text-align: center;
        color: blue;
        text-decoration: none;
        font-weight: bold;
    }

        .back:hover {
            color: red;
        }
</style>

<h2>Product Details</h2>

<table>
    <tr>
        <th>Product ID</th>
        <td>@Model.Id</td>
    </tr>
    <tr>
        <th>Name</th>
        <td>@Model.Name</td>
    </tr>
    <tr>
        <th>Price</th>
        <td>₹@Model.Price</td>
    </tr>
    <tr>
        <th>Category</th>
        <td>@Model.Category</td>
    </tr>
</table>

<a class="back" asp-controller="Product" asp-action="Index">
    Back to Product Catalog
</a>